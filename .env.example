# Copy to .env for local development. Never commit secrets.\nNODE_ENV=development\nPORT=3001\nHOST=127.0.0.1\nDATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chaotic_gaming_dev\nDATABASE_SSL=false\nLOG_LEVEL=info\n\n# Optional Steam account linking\n# STEAM_OPENID_RETURN_URL=https://core.example.test/api/account/link/steam/callback\n\n# Optional Discord OAuth account linking. Configure all three together.\n# Register the exact redirect URL in the Discord Developer Portal.\n# DISCORD_OAUTH_CLIENT_ID=\n# DISCORD_OAUTH_CLIENT_SECRET=\n# DISCORD_OAUTH_REDIRECT_URL=https://core.example.test/auth/discord-link/callback\n# Optional fixed website destination after a successful link.\n# DISCORD_LINK_COMPLETE_URL=https://www.chaoticmindsgaming.com/account/linked-accounts\n