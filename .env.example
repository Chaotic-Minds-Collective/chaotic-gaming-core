# Local development only. Never put production credentials in this file.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chaotic_gaming_dev
DATABASE_SSL=false
STEAM_OPENID_RETURN_URL=https://www.chaoticmindsgaming.com/api/account/link/steam/callback

# Optional Discord OAuth2 account linking. Register this exact redirect URI
# in the Discord Developer Portal OAuth2 settings before enabling the flow.
# Use the same Discord application as Glitch Bot unless a separate app is intended.
DISCORD_OAUTH_CLIENT_ID=
DISCORD_OAUTH_CLIENT_SECRET=
DISCORD_OAUTH_REDIRECT_URI=https://www.chaoticmindsgaming.com/api/account/link/discord/callback

LOG_LEVEL=info
