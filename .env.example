# Local development only. Never put production credentials in this file.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/chaotic_gaming_dev
DATABASE_SSL=false
STEAM_OPENID_RETURN_URL=https://www.chaoticmindsgaming.com/api/account/link/steam/callback
LOG_LEVEL=info

# Optional Discord OAuth account linking. Configure all three together.
# Register this exact redirect URL in the Discord Developer Portal.
# DISCORD_OAUTH_CLIENT_ID=
# DISCORD_OAUTH_CLIENT_SECRET=
# DISCORD_OAUTH_REDIRECT_URL=https://core.example.test/auth/discord-link/callback
# Optional fixed website destination after successful linking.
# DISCORD_LINK_COMPLETE_URL=https://www.chaoticmindsgaming.com/account/linked-accounts
